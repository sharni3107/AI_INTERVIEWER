# LLM Provider
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=YOUR_NEW_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model
LLM_MODEL=openai/gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.4

# Interview Rules
INTERVIEW_MIN_QUESTIONS=8
INTERVIEW_MIN_DAYS=4
INTERVIEW_MAX_QUESTIONS=16

# Data Locations
CURRICULUM_PATH=data/curriculum.json
TECHSPEC_PATH=data/techspec.md
CHROMA_PERSIST_DIR=data/.chroma
RAG_TOP_K=4

# Application
DEBUG=false